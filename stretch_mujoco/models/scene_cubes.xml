<mujoco model="stretch scene cubes">
  <include file="stretch.xml"/>
  <include file="docking_station.xml"/>

  <statistic center="0 0 .75" extent="1.2" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <asset>
    <material name="floor" rgba=".1 .1 .1 1" reflectance="0.1"/>
    <texture type="2d" name="wood" file="wood.png"/>
    <material name="wood" texture="wood"/>
    <texture type="skybox" builtin="gradient" rgb1="0.44 0.80 1.00" rgb2="1 1 1" width="512" height="3072"/>

    <!-- Marcadores ArUco: generados por generate_aruco.py -->
    <texture type="2d" name="aruco0_tex" file="aruco_0.png"/>
    <texture type="2d" name="aruco1_tex" file="aruco_1.png"/>
    <material name="mat_aruco0" texture="aruco0_tex" texrepeat="1 1" specular="0" shininess="0"/>
    <material name="mat_aruco1" texture="aruco1_tex" texrepeat="1 1" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <!-- Cámara de tercera persona fija -->
    <camera name="overhead_rgb" pos="0 0.5 1.5" xyaxes="1 0 0 0 0.555 -0.832" fovy="60"/>

    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>

    <body name="table" pos="0 -1 .24">
      <geom type="box" size=".6 .5 .24" mass="1" material="wood"/>
    </body>

    <!-- Cubo azul (ArUco ID=0 en la cara superior) -->
    <body name="cube_blue" pos="-.04 -0.55 .65">
      <freejoint/>
      <geom type="box" size=".04 .04 .04" mass=".3" rgba="0 0.2 1 1"/>
      <!-- Marcador ArUco como capa fina encima del cubo -->
      <geom type="box" pos="0 0 0.042" size=".036 .036 .001"
            material="mat_aruco0" rgba="1 1 1 1"/>
    </body>

    <!-- Cubo rojo (ArUco ID=1 en la cara superior) -->
    <body name="cube_red" pos=".12 -0.55 .65">
      <freejoint/>
      <geom type="box" size=".04 .04 .04" mass=".3" rgba="1 0.1 0 1"/>
      <!-- Marcador ArUco como capa fina encima del cubo -->
      <geom type="box" pos="0 0 0.042" size=".036 .036 .001"
            material="mat_aruco1" rgba="1 1 1 1"/>
    </body>
  </worldbody>
</mujoco>
